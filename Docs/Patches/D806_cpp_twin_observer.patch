+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHOLChatObserverTest, "HeroesOfLiberty.Chat.Observer", UE::HeroesOfLiberty::Tests::Chat::Flags)
+
+bool FHOLChatObserverTest::RunTest(const FString& Parameters)
+{
+	// D806 (Q-chat-rules A, mirror of Script/Chat/HOLChatRules.as): an observer without a seat (INDEX_NONE, or slot 3 past the three
+	// seats for a second one) is treated as a defeated one: All and Allies with the spectators, never a private message.
+	using namespace UE::HeroesOfLiberty::Tests::Chat;
+	const HOLChat::FSeats CarolOut = ThreeSeats(false, 2);
+	constexpr int32 Observer = INDEX_NONE, SecondObserver = 3;
+	TestEqual(TEXT("The observer's Allies: the defeated Carol reads it, no living player"), Describe(HOLChat::Recipients(CarolOut, HOLChat::Allies, Observer, INDEX_NONE)), FString(TEXT("-1,2")));
+	TestTrue(TEXT("The observer's Allies reaches a second observer"), HOLChat::Reaches(CarolOut, HOLChat::Allies, Observer, INDEX_NONE, SecondObserver));
+	TestTrue(TEXT("The defeated Carol's Allies reaches the observer"), HOLChat::Reaches(CarolOut, HOLChat::Allies, 2, INDEX_NONE, Observer));
+	TestEqual(TEXT("The observer's private to the defeated Carol: nobody"), Describe(HOLChat::Recipients(CarolOut, HOLChat::Private, Observer, 2)), FString(TEXT("-1")));
+	TestFalse(TEXT("The observer's private reaches no second observer"), HOLChat::Reaches(CarolOut, HOLChat::Private, Observer, SecondObserver, SecondObserver));
+	TestFalse(TEXT("Two observers share INDEX_NONE: a private one is not even read back"), HOLChat::Reaches(CarolOut, HOLChat::Private, Observer, 2, Observer));
+	TestTrue(TEXT("Two observers share INDEX_NONE: their All is read"), HOLChat::Reaches(CarolOut, HOLChat::All, Observer, INDEX_NONE, Observer));
+	TestEqual(TEXT("The observer's All: the spectators alone (D376)"), Describe(HOLChat::Recipients(CarolOut, HOLChat::All, Observer, INDEX_NONE)), FString(TEXT("-1,2")));
+	TestTrue(TEXT("D792 1 A: Alice's All reaches the observer"), HOLChat::Reaches(CarolOut, HOLChat::All, 0, INDEX_NONE, Observer));
+	TestFalse(TEXT("Alice's Allies never reaches the observer"), HOLChat::Reaches(CarolOut, HOLChat::Allies, 0, INDEX_NONE, Observer));
+	return true;
+}
