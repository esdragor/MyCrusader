diff --git a/Source/HeroesOfLiberty/Tests/HOLAvoidTests.cpp b/Source/HeroesOfLiberty/Tests/HOLAvoidTests.cpp
index 73f6da6..6daca8f 100644
--- a/Source/HeroesOfLiberty/Tests/HOLAvoidTests.cpp
+++ b/Source/HeroesOfLiberty/Tests/HOLAvoidTests.cpp
@@ -230,4 +230,64 @@ bool FHOLAvoidLoopPatienceTest::RunTest(const FString& Parameters)
 	return true;
 }
 
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHOLAvoidStuckHoldTest, "HeroesOfLiberty.Movement.StuckHold",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+bool FHOLAvoidStuckHoldTest::RunTest(const FString& Parameters)
+{
+	// D641: a soldier asked to walk that stays within 30 cm of its place for 1 s stands 1 s, then tries again (20 Hz steps).
+	const double Dt = 0.05;
+	const auto Step = [Dt](HOLAvoid::FStuckHold& State, const FVector2D& Place, const double Speed = 697.)
+	{
+		return HOLAvoid::StepStuckHold(State, Place, FVector2D(Speed, 0.), Dt, 30., 1., 1.);
+	};
+	{
+		HOLAvoid::FStuckHold State;
+		bool bHeld = false;
+		for (int32 Index = 0; Index < 200; ++Index)
+		{
+			bHeld |= Step(State, FVector2D(Index * 35., 0.));
+		}
+		TestFalse(TEXT("a walk that gets on never stands"), bHeld);
+	}
+	{
+		// Pushing against a tree: 1 cm of noise a step, going nowhere.
+		HOLAvoid::FStuckHold State;
+		int32 HeldAt = INDEX_NONE;
+		for (int32 Index = 0; Index < 60 && HeldAt == INDEX_NONE; ++Index)
+		{
+			if (Step(State, FVector2D((Index % 2) * 1., 0.)))
+			{
+				HeldAt = Index;
+			}
+		}
+		TestTrue(TEXT("stuck against an obstacle, it stands"), HeldAt != INDEX_NONE);
+		TestTrue(TEXT("after about a second"), HeldAt >= 18 && HeldAt <= 22);
+		int32 Steps = 0;
+		while (Step(State, FVector2D::ZeroVector) && Steps < 200)
+		{
+			++Steps;
+		}
+		TestTrue(TEXT("it stands a second"), Steps >= 18 && Steps <= 21);
+		TestFalse(TEXT("then it tries again"), Step(State, FVector2D::ZeroVector));
+	}
+	{
+		// Standing (asked under 50 cm/s) is not being stuck; off at 0 seconds.
+		HOLAvoid::FStuckHold State;
+		bool bHeld = false;
+		for (int32 Index = 0; Index < 100; ++Index)
+		{
+			bHeld |= Step(State, FVector2D::ZeroVector, 10.);
+		}
+		TestFalse(TEXT("asked nothing, it is not stuck"), bHeld);
+		HOLAvoid::FStuckHold Off;
+		bool bOffHeld = false;
+		for (int32 Index = 0; Index < 100; ++Index)
+		{
+			bOffHeld |= HOLAvoid::StepStuckHold(Off, FVector2D::ZeroVector, FVector2D(697., 0.), Dt, 30., 0., 1.);
+		}
+		TestFalse(TEXT("0 seconds: off"), bOffHeld);
+	}
+	return true;
+}
+
 #endif
