+
+	/**
+	 * D641 (the soldier stuck against a fixed obstacle): the state of a melee that is asked to walk and does not get anywhere: the place it is held
+	 * from (anchor, valid once Anchored), the seconds it has been asked to walk without leaving that place, and the seconds it still stands.
+	 */
+	struct FStuckHold
+	{
+		FVector2D Anchor = FVector2D::ZeroVector;
+		bool bAnchored = false;
+		double StuckSeconds = 0.;
+		double HoldSeconds = 0.;
+	};
+
+	/**
+	 * One step of the rule: the unit at Place is asked Asked (cm/s; under 50 is standing). It is "stuck" while it stays within RadiusCm of its anchor
+	 * though it is asked to walk; after AfterSeconds of that it stands (true) for HoldSeconds, its anchor taken again, then tries again: a soldier
+	 * whose path runs into a tree or a rock does not pivot on the spot pushing against it (the to and fro of hol.Test.SanityMotion), it waits.
+	 * AfterSeconds at 0 or less: off, the state cleared. Returns true while the unit must stand still.
+	 */
+	HEROESOFLIBERTY_API bool StepStuckHold(FStuckHold& State, const FVector2D& Place, const FVector2D& Asked, double DeltaTime, double RadiusCm, double AfterSeconds, double HoldSeconds);
 }
