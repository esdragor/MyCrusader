 	}
 	return false;
 }
+
+bool HOLAvoid::StepStuckHold(FStuckHold& State, const FVector2D& Place, const FVector2D& Asked, const double DeltaTime, const double RadiusCm, const double AfterSeconds, const double HoldSeconds)
+{
+	if (AfterSeconds <= 0.)
+	{
+		State = FStuckHold();
+		return false;
+	}
+	if (State.HoldSeconds > 0.)
+	{
+		State.HoldSeconds -= DeltaTime;
+		return true;
+	}
+	if (!State.bAnchored || Asked.SizeSquared() <= FMath::Square(50.) || FVector2D::DistSquared(Place, State.Anchor) > FMath::Square(RadiusCm))
+	{
+		State.Anchor = Place;
+		State.bAnchored = true;
+		State.StuckSeconds = 0.;
+		return false;
+	}
+	State.StuckSeconds += DeltaTime;
+	if (State.StuckSeconds >= AfterSeconds)
+	{
+		State.StuckSeconds = 0.;
+		State.HoldSeconds = HoldSeconds;
+		State.Anchor = Place;
+		return true;
+	}
+	return false;
+}
