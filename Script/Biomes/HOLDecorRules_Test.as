// The generic decor's pure rule, alone (BiomeInProgress.md B3, GDD D651 to D656): the Angelscript port of the map recipes' decor_transforms
// (Tools/Editor/maps/common.py), laid at load time from a seed so that the server and every client draw the SAME decor. Every number
// expected here was drawn from the PYTHON it is ported from (Tools/Tests/biome_decor_golden.py writes the block below; its --check says
// when the Python drifted), on fixed seeds; the rule's own properties (inside the bounds, away from the avoided points, deterministic)
// are held to every place of the lists.

// What the Python drew for one case: its inputs, the count, the first four places (x, y, turn, size), the last place and the sums.
struct FHOLDecorGolden
{
	int64 LayoutSeed = 0;
	double Half = 0.0;
	double PerHectare = 0.0;
	int64 Salt = 0;
	int Count = 0;
	TArray<double> First;
	TArray<double> Last;
	double SumX = 0.0;
	double SumY = 0.0;
	double SumTurn = 0.0;
	double SumSize = 0.0;
}

// GOLDEN BEGIN (generated by Tools/Tests/biome_decor_golden.py --write from maps/common.py; never edit by hand)
TArray<uint> GoldenMixSeeds()
{
	TArray<uint> R;
	R.Add(2873804605);  // MixSeed of (1, 71, 3)
	R.Add(3127254782);  // MixSeed of (7, 72, 3)
	R.Add(3719718745);  // MixSeed of (-5, 2)
	R.Add(3442682895);  // MixSeed of (123456789, 0, 4294967295)
	return R;
}

TArray<int64> GoldenMixInputs(int Which)
{
	TArray<int64> R;
	if (Which == 0) { R.Add(1); R.Add(71); R.Add(3); }
	else if (Which == 1) { R.Add(7); R.Add(72); R.Add(3); }
	else if (Which == 2) { R.Add(-5); R.Add(2); }
	else { R.Add(123456789); R.Add(0); R.Add(4294967295); }
	return R;
}

