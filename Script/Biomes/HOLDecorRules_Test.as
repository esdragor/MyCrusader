// GOLDEN END

bool DecorNear(double A, double B, double Tolerance)
{
	return Math::Abs(A - B) <= Tolerance;
}

TArray<FHOLDecorPlace> DecorOfCase(const FHOLDecorGolden& G, const TArray<FVector2D>& Avoid)
{
	return HOLDecor::Transforms(G.LayoutSeed, G.Half, Avoid, G.PerHectare, G.Salt);
}

// The seed mixer gives the Python's seeds to the last bit (negative and 32-bit-wide inputs included).
void Test_DecorMixSeedMatchesPython(FUnitTest& T)
{
	TArray<uint> Golden = GoldenMixSeeds();
	T.AssertTrue(Golden.Num() == 4, "four mixed seeds in the golden block");
	for (int Which = 0; Which < Golden.Num(); Which++)
	{
		uint Mixed = HOLDecor::MixSeed(GoldenMixInputs(Which));
		T.AssertTrue(Mixed == Golden[Which], f"mix seed {Which}: the Python's {Golden[Which]}, the script's {Mixed}");
	}
}

// The xorshift32 stream and its uniform draws are the Python's.
void Test_DecorRngMatchesPython(FUnitTest& T)
{
	TArray<uint> Stream = GoldenRngStream();
	TArray<double> Uniforms = GoldenRngUniforms();
	TArray<int64> Seed;
	Seed.Add(7);
	Seed.Add(71);
	Seed.Add(3);
	FHOLDecorRng Rng = HOLDecor::MakeRng(Seed);
	for (int Index = 0; Index < Stream.Num(); Index++)
	{
		uint Draw = HOLDecor::NextU32(Rng);
		T.AssertTrue(Draw == Stream[Index], f"draw {Index}: the Python's {Stream[Index]}, the script's {Draw}");
	}
	FHOLDecorRng Again = HOLDecor::MakeRng(Seed);
	for (int Index = 0; Index < Uniforms.Num(); Index++)
	{
		double Value = HOLDecor::Uniform(Again);
		T.AssertTrue(DecorNear(Value, Uniforms[Index], 1e-12), f"uniform {Index}: the Python's {Uniforms[Index]}, the script's {Value}");
		T.AssertTrue(Value >= 0.0 && Value < 1.0, f"uniform {Index} is in [0, 1)");
	}
}

// The smooth noise that thins the decor out in patches is the Python's field.
void Test_DecorNoiseMatchesPython(FUnitTest& T)
{
	TArray<FVector2D> Probes = GoldenNoiseProbes();
	TArray<double> Values = GoldenNoiseValues();
	TArray<int64> Seed;
	Seed.Add(7);
	Seed.Add(72);
	Seed.Add(3);
	FHOLDecorNoise Noise = HOLDecor::MakeNoise(HOLDecor::MixSeed(Seed), 3, 2500.0, 9000.0);
	for (int Index = 0; Index < Probes.Num(); Index++)
	{
		double Value = HOLDecor::NoiseValue(Noise, Probes[Index].X, Probes[Index].Y);
		T.AssertTrue(DecorNear(Value, Values[Index], 1e-9), f"noise at probe {Index}: the Python's {Values[Index]}, the script's {Value}");
	}
}

// The whole rule agrees with the Python on fixed seeds: same count, same first and last places, same sums.
void Test_DecorTransformsMatchPython(FUnitTest& T)
{
	TArray<FVector2D> Avoid = GoldenAvoid();
	for (int Which = 0; Which < 2; Which++)
	{
		FHOLDecorGolden G = GoldenCase(Which);
		TArray<FHOLDecorPlace> Places = DecorOfCase(G, Avoid);
		T.AssertEquals(G.Count, Places.Num(), f"case {Which}: as many places as the Python drew");
		if (Places.Num() != G.Count || Places.Num() < 4)
		{
			continue;
		}
		for (int Index = 0; Index < 4; Index++)
		{
			FHOLDecorPlace P = Places[Index];
			T.AssertTrue(DecorNear(P.X, G.First[Index * 4], 1e-6) && DecorNear(P.Y, G.First[Index * 4 + 1], 1e-6), f"case {Which}: place {Index} is the Python's ({P.X}, {P.Y})");
			T.AssertTrue(DecorNear(P.Turn, G.First[Index * 4 + 2], 1e-9) && DecorNear(P.Size, G.First[Index * 4 + 3], 1e-9), f"case {Which}: place {Index} turn and size are the Python's");
		}
		FHOLDecorPlace Last = Places[Places.Num() - 1];
		T.AssertTrue(DecorNear(Last.X, G.Last[0], 1e-6) && DecorNear(Last.Y, G.Last[1], 1e-6), f"case {Which}: the last place is the Python's");
		double SumX = 0.0;
		double SumY = 0.0;
		double SumTurn = 0.0;
		double SumSize = 0.0;
		for (const FHOLDecorPlace& P : Places)
		{
			SumX += P.X;
			SumY += P.Y;
			SumTurn += P.Turn;
			SumSize += P.Size;
		}
		T.AssertTrue(DecorNear(SumX, G.SumX, 1e-3) && DecorNear(SumY, G.SumY, 1e-3), f"case {Which}: the sums of the positions are the Python's");
		T.AssertTrue(DecorNear(SumTurn, G.SumTurn, 1e-6) && DecorNear(SumSize, G.SumSize, 1e-6), f"case {Which}: the sums of the turns and sizes are the Python's");
	}
}

// The same seed gives the same decor on every call (what lets a client and the server agree); another seed or another kind's salt does not.
void Test_DecorDeterministic(FUnitTest& T)
{
	TArray<FVector2D> Avoid = GoldenAvoid();
	FHOLDecorGolden G = GoldenCase(0);
	TArray<FHOLDecorPlace> First = DecorOfCase(G, Avoid);
	TArray<FHOLDecorPlace> Second = DecorOfCase(G, Avoid);
	T.AssertTrue(First.Num() > 100, "a plain map's decor has places to compare");
	T.AssertEquals(First.Num(), Second.Num(), "two calls, the same count");
	bool Same = First.Num() == Second.Num();
	for (int Index = 0; Same && Index < First.Num(); Index++)
	{
		Same = First[Index].X == Second[Index].X && First[Index].Y == Second[Index].Y && First[Index].Turn == Second[Index].Turn && First[Index].Size == Second[Index].Size;
	}
	T.AssertTrue(Same, "two calls, the very same places");
	TArray<FHOLDecorPlace> OtherSalt = HOLDecor::Transforms(G.LayoutSeed, G.Half, Avoid, G.PerHectare, G.Salt + 1);
	TArray<FHOLDecorPlace> OtherSeed = HOLDecor::Transforms(G.LayoutSeed + 1, G.Half, Avoid, G.PerHectare, G.Salt);
	T.AssertTrue(OtherSalt.Num() > 0 && (OtherSalt[0].X != First[0].X || OtherSalt[0].Y != First[0].Y), "another kind (salt) lays other places");
	T.AssertTrue(OtherSeed.Num() > 0 && (OtherSeed[0].X != First[0].X || OtherSeed[0].Y != First[0].Y), "another layout seed lays other places");
}

// The rule's own promises, whatever the Python says: inside the bounds, none within the clear distance of an avoided point (the effect:
// a place is refused), turn and size in [0, 1), never more than asked; an empty density lays nothing.
void Test_DecorKeepsItsPromises(FUnitTest& T)
{
	TArray<FVector2D> Avoid = GoldenAvoid();
	for (int Which = 0; Which < 2; Which++)
	{
		FHOLDecorGolden G = GoldenCase(Which);
		TArray<FHOLDecorPlace> Places = DecorOfCase(G, Avoid);
		T.AssertTrue(Places.Num() > 0, f"case {Which}: some decor is laid");
		T.AssertTrue(Places.Num() <= HOLDecor::Requested(G.Half, G.PerHectare), f"case {Which}: never more than the density asks");
		int Outside = 0;
		int TooClose = 0;
		int BadDraw = 0;
		for (const FHOLDecorPlace& P : Places)
		{
			if (P.X < -G.Half || P.X > G.Half || P.Y < -G.Half || P.Y > G.Half)
			{
				Outside++;
			}
			for (const FVector2D& A : Avoid)
			{
				if (Math::Sqrt((P.X - A.X) * (P.X - A.X) + (P.Y - A.Y) * (P.Y - A.Y)) < HOLDecor::ClearCm)
				{
					TooClose++;
				}
			}
			if (P.Turn < 0.0 || P.Turn >= 1.0 || P.Size < 0.0 || P.Size >= 1.0)
			{
				BadDraw++;
			}
		}
		T.AssertEquals(0, Outside, f"case {Which}: no place outside the bounds");
		T.AssertEquals(0, TooClose, f"case {Which}: no place within the clear distance of an avoided point");
		T.AssertEquals(0, BadDraw, f"case {Which}: turn and size stay in [0, 1)");
		// Without anything to avoid the same draw lays at least as many places: the avoided points really refuse places.
		TArray<FVector2D> None;
		T.AssertTrue(HOLDecor::Transforms(G.LayoutSeed, G.Half, None, G.PerHectare, G.Salt).Num() >= Places.Num(), f"case {Which}: avoiding points never adds places");
	}
	// A wall of avoided points over the whole map refuses what the free map lays.
	TArray<FVector2D> Wall;
	for (int X = -41; X <= 41; X++)
	{
		for (int Y = -41; Y <= 41; Y++)
		{
			Wall.Add(FVector2D(X * 500.0, Y * 500.0));
		}
	}
	FHOLDecorGolden Plain = GoldenCase(0);
	T.AssertEquals(0, HOLDecor::Transforms(Plain.LayoutSeed, Plain.Half, Wall, Plain.PerHectare, Plain.Salt).Num(), "a map covered with avoided points lays nothing");
	T.AssertEquals(0, HOLDecor::Transforms(Plain.LayoutSeed, Plain.Half, Avoid, 0.0, Plain.Salt).Num(), "an empty density lays nothing");
}

// The count the density asks of a map: per hectare of the bounded square, 1 hectare = 10 000 m2 = 1e8 cm2.
void Test_DecorRequestedCount(FUnitTest& T)
{
	T.AssertEquals(2400, HOLDecor::Requested(20000.0, 150.0), "a 400 m side at 150 per hectare: 2400");
	T.AssertEquals(0, HOLDecor::Requested(20000.0, 0.0), "no density, no places");
	T.AssertEquals(HOLDecor::Requested(40000.0, 100.0), 4 * HOLDecor::Requested(20000.0, 100.0), "twice the side, four times the places");
}
