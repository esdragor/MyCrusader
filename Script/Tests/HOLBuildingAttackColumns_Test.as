// F8 (D884): the attack columns of the building type table, read as the simulation reads it (HOLBuildingType::FindRow on the REAL table
// Tools/Data/BuildingTypes.csv -> BuildingTypes.uasset, regenerated by Tools/AutoJourney/regen_tables.ps1), never from a typed copy of a figure.
// The wanted figures are written once here, as the decision D884 states them: 5 damage per arrow, one shot every 1.625 s, reach 3000 cm,
// the tower shoots even when empty. DATA ONLY: no processor reads these columns yet, so nothing changes in the game until the building fire exists.
// Red until BuildingTypes.csv carries the columns AND the table is regenerated.

// TowerWood is the only building that shoots, and its row says how (damage, cadence, reach, fires empty).
void Test_TowerWoodRowCarriesTheAttackColumns(FUnitTest& T)
{
	FHOLBuildingTypeRow Row;
	T.AssertTrue(HOLBuildingType::FindRow(n"TowerWood", Row), "TowerWood is a row of the building type table");
	T.AssertEquals(5, Row.BuildingAttack, "D884: an arrow of the Wood watch tower does 5 damage");
	T.AssertTrue(Math::IsNearlyEqual(Row.BuildingAttackInterval, 1.625f, 0.001f), "D884: one shot every 1.625 s");
	T.AssertTrue(Math::IsNearlyEqual(Row.BuildingAttackRange, 3000.f, 0.5f), "D884: reach 3000 cm");
	T.AssertTrue(Row.BuildingFiresEmpty, "D884: the Wood watch tower shoots even with nobody inside");
}

// Every other row of the real table has no attack: the columns are zero, the building shoots nothing.
void Test_OtherBuildingsHaveNoAttack(FUnitTest& T)
{
	TArray<FName> Others;
	Others.Add(n"House");
	Others.Add(n"Barracks");
	Others.Add(n"ArcheryRange");
	Others.Add(n"LumberCamp");
	for (int Index = 0; Index < Others.Num(); Index++)
	{
		FHOLBuildingTypeRow Row;
		T.AssertTrue(HOLBuildingType::FindRow(Others[Index], Row), Others[Index].ToString() + " is a row of the building type table");
		T.AssertEquals(0, Row.BuildingAttack, Others[Index].ToString() + " does no building attack");
		T.AssertTrue(Math::IsNearlyEqual(Row.BuildingAttackInterval, 0.f, 0.0001f), Others[Index].ToString() + " has no cadence");
		T.AssertTrue(Math::IsNearlyEqual(Row.BuildingAttackRange, 0.f, 0.0001f), Others[Index].ToString() + " has no reach");
		T.AssertFalse(Row.BuildingFiresEmpty, Others[Index].ToString() + " does not fire empty");
	}
}
