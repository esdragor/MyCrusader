<!--
  The launcher's home window (launcher 5): key art filling the window under its own title bar, the game's text logo
  and the big split button at the left, the information panel (release notes, announcements) and the community links
  at the right. Behaviour in MainWindow*.cs; every player text comes from Texts (Tr here, code for the live ones).
-->
<Window x:Class="HOLLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HOLLauncher"
        Width="1280" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource ChromeBackBrush}" Foreground="{DynamicResource TextBrush}"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DropShadowEffect x:Key="ArtShadow" Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.85" />
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid x:Name="Root" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Key art, or the host's picture, darkened at the left and bottom for the texts drawn on it. -->
            <Grid Grid.Row="1" IsHitTestVisible="False">
                <local:KeyArt x:Name="Art" />
                <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#D0100A0C" />
                            <GradientStop Offset="0.32" Color="#80100A0C" />
                            <GradientStop Offset="0.62" Color="#00100A0C" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.45" Color="#00100A0C" />
                            <GradientStop Offset="0.8" Color="#A0100A0C" />
                            <GradientStop Offset="1" Color="#E0100A0C" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- Title bar: emblem and name (drag), refresh / settings / report, then the window's buttons. -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource ChromeBackBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconEmblem}" Fill="{DynamicResource GoldBrush}" Width="16" Height="16" Stretch="None"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChromeTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="RefreshIcon" Style="{StaticResource ChromeButton}" ToolTip="{local:Tr Refresh}" Click="OnRefreshClick">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconStroke}" />
                    </Button>
                    <Button x:Name="SettingsIcon" Style="{StaticResource ChromeButton}" ToolTip="{local:Tr Settings}" Click="OnSettingsClick">
                        <Path Data="{StaticResource IconGear}" Style="{StaticResource IconFill}" />
                    </Button>
                    <Button x:Name="ReportIcon" Style="{StaticResource ChromeButton}" ToolTip="{local:Tr ReportSend}" Click="OnReportClick">
                        <Path Data="{StaticResource IconHelp}" Style="{StaticResource IconStroke}" />
                    </Button>
                    <Rectangle Width="1" Margin="8,11" Fill="{DynamicResource BorderBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeButton}" ToolTip="{local:Tr WindowMinimize}" Click="OnMinimizeClick">
                        <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconStroke}" StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Click="OnMaximizeClick">
                        <Path x:Name="MaximizeGlyph" Data="{StaticResource IconMaximize}" Style="{StaticResource IconStroke}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" ToolTip="{local:Tr WindowClose}" Click="OnCloseClick">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconStroke}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content over the art. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="0.72*" MinWidth="400" MaxWidth="560" />
                </Grid.ColumnDefinitions>

                <!-- Left: the logo, then the state, the big button, the run's bar and the footer line. -->
                <Grid Grid.Column="0" Margin="56,36,32,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="Logo" Effect="{StaticResource ArtShadow}" HorizontalAlignment="Left">
                        <TextBlock x:Name="LogoTop" FontFamily="Palatino Linotype, Georgia, serif" FontSize="74" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GoldBrush}" LineHeight="76" LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Name="LogoBottom" FontFamily="Palatino Linotype, Georgia, serif" FontSize="40" FontStyle="Italic"
                                   Foreground="{DynamicResource GoldBrush}" Margin="64,-4,0,0" />
                        <Grid Margin="2,12,0,0" Width="300" HorizontalAlignment="Left">
                            <Rectangle Height="1.5" Fill="{DynamicResource GoldBrush}" Opacity="0.75" VerticalAlignment="Center" />
                            <Path Data="M 0,6 L 6,0 L 12,6 L 6,12 Z" Fill="{DynamicResource GoldBrush}" HorizontalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{local:Tr HeaderSubtitle}" Foreground="{DynamicResource ArtMutedBrush}" FontSize="14"
                                   Margin="2,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Left" MaxWidth="480">
                        <TextBlock x:Name="StateText" Foreground="{DynamicResource ArtTextBrush}" FontSize="15" TextWrapping="Wrap"
                                   Effect="{StaticResource ArtShadow}" Margin="2,0,0,4" />
                        <TextBlock x:Name="LauncherNote" Foreground="{DynamicResource GoldBrush}" FontSize="13" TextWrapping="Wrap"
                                   Effect="{StaticResource ArtShadow}" Margin="2,0,0,4" Visibility="Collapsed" />
                        <Grid Margin="0,10,0,0" Height="64" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="280" Click="OnPrimaryClick" />
                            <Button x:Name="GearButton" Grid.Column="1" Style="{StaticResource PrimaryGearButton}"
                                    ToolTip="{local:Tr MoreActions}" Click="OnGearClick">
                                <Path Data="{StaticResource IconGear}" Style="{StaticResource IconFill}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource ArtTextBrush}" FontSize="13" TextWrapping="Wrap"
                                       Effect="{StaticResource ArtShadow}" Margin="2,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="RunBar" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0"
                                        Content="{local:Tr Cancel}" Click="OnCancelClick" />
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="FooterPanel" Orientation="Horizontal" Margin="2,16,0,0" Background="Transparent">
                            <TextBlock x:Name="FooterText" Foreground="{DynamicResource ArtMutedBrush}" FontSize="12.5"
                                       Effect="{StaticResource ArtShadow}" VerticalAlignment="Center" />
                            <Ellipse x:Name="FooterDot" Width="9" Height="9" Margin="7,1,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource ServerUnknownBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Right: the information panel, then the community links. -->
                <Grid Grid.Column="1" Margin="0,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="InfoPanel" Background="{DynamicResource PanelBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="22,18,22,10">
                                <TextBlock Text="{local:Tr InfoTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           Opacity="0.85" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="UpdatesTab" Style="{StaticResource TabButton}" GroupName="InfoTabs" IsChecked="True"
                                                 Content="{local:Tr TabUpdates}" Checked="OnTabChecked" />
                                    <RadioButton x:Name="AnnouncementsTab" Style="{StaticResource TabButton}" GroupName="InfoTabs"
                                                 Content="{local:Tr TabAnnouncements}" Checked="OnTabChecked" Visibility="Collapsed" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,-1,0,0" />
                            </StackPanel>
                            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,6,12">
                                <StackPanel x:Name="Cards" Margin="22,6,14,8" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="LinksRow" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"
                                Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
