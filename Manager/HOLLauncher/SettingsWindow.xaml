<!-- The "Settings" window (L15, L19, L22, launcher 5, L23): general, game launch, background; logic in SettingsModel. -->
<Window x:Class="HOLLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HOLLauncher"
        Width="700" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontSize="14" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Frame" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="40" Background="{DynamicResource ChromeBackBrush}">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconGear}" Fill="{DynamicResource GoldBrush}" Width="16" Height="16" Stretch="None" />
                    <TextBlock Text="{local:Tr Settings}" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource ChromeTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource ChromeCloseButton}" HorizontalAlignment="Right" ToolTip="{local:Tr WindowClose}" IsCancel="True"
                        Click="OnCancelClick">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconStroke}" StrokeThickness="1" />
                </Button>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,20">
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="{local:Tr SettingsSave}" IsDefault="True"
                        Click="OnSaveClick" />
                <Button Style="{StaticResource SecondaryButton}" Content="{local:Tr Cancel}" Margin="10,0,0,0" Click="OnCancelClick" />
            </StackPanel>
            <!-- L23: three sections are taller than a small laptop screen: the fields scroll, the buttons stay (MaxHeight in code). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="24,4,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Text="{local:Tr SettingsGeneral}" Margin="0,12,0,8" />

                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsLanguage}" />
                <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="0,4" />

                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsTheme}" />
                <ComboBox x:Name="ThemeBox" Grid.Row="2" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="0,4" />

                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsGameDir}" />
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GameDirBox" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{local:Tr SettingsBrowse}" Margin="8,0,0,0"
                            Click="OnBrowseClick" />
                </Grid>
                <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,2,0,0"
                        Content="{local:Tr SettingsLauncherDir}" Click="OnLauncherDirClick" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}" Text="{local:Tr SettingsGameDirHint}" />

                <CheckBox x:Name="CloseOnPlayBox" Grid.Row="6" Grid.Column="1" Margin="0,4,0,0" Content="{local:Tr SettingsCloseOnPlay}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Hint}" Margin="28,2,0,6" Text="{local:Tr SettingsCloseOnPlayHint}" />

                <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Text="{local:Tr SettingsLaunch}" />

                <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsDisplayMode}" />
                <ComboBox x:Name="DisplayBox" Grid.Row="9" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="0,4" />

                <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsResolution}" />
                <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <ComboBox x:Name="ResolutionBox" Width="210" SelectionChanged="OnResolutionChanged" />
                    <TextBox x:Name="WidthBox" Width="76" Margin="12,0,0,0" HorizontalContentAlignment="Right" />
                    <TextBlock x:Name="TimesText" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <TextBox x:Name="HeightBox" Width="76" HorizontalContentAlignment="Right" />
                </StackPanel>

                <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsExtraArguments}" />
                <TextBox x:Name="ExtraBox" Grid.Row="11" Grid.Column="1" Margin="0,4" />
                <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource Hint}" Text="{local:Tr SettingsExtraArgumentsHint}" />

                <!-- L23: the launcher in the background (notification area, automatic updates, start with Windows). -->
                <TextBlock Grid.Row="13" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Text="{local:Tr SettingsBackground}" />

                <TextBlock Grid.Row="14" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsAutoUpdate}" />
                <ComboBox x:Name="AutoUpdateBox" Grid.Row="14" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="0,4"
                          SelectionChanged="OnAutoUpdateChanged" />

                <TextBlock Grid.Row="15" Style="{StaticResource FieldLabel}" Text="{local:Tr SettingsCheckEvery}" />
                <StackPanel Grid.Row="15" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <TextBox x:Name="IntervalBox" Width="76" HorizontalContentAlignment="Right" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                               Text="{local:Tr SettingsMinutes}" />
                </StackPanel>
                <TextBlock Grid.Row="16" Grid.Column="1" Style="{StaticResource Hint}" Text="{local:Tr SettingsAutoUpdateHint}" />

                <CheckBox x:Name="MinimizeToTrayBox" Grid.Row="17" Grid.Column="1" Margin="0,4,0,0" Content="{local:Tr SettingsMinimizeToTray}" />
                <TextBlock Grid.Row="18" Grid.Column="1" Style="{StaticResource Hint}" Margin="28,2,0,6" Text="{local:Tr SettingsMinimizeToTrayHint}" />

                <CheckBox x:Name="StartWithWindowsBox" Grid.Row="19" Grid.Column="1" Margin="0,4,0,8" Content="{local:Tr SettingsStartWithWindows}" />
            </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
