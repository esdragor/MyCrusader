<!-- The launcher's message and question dialog (launcher 5): its theme and its buttons in the player's language. -->
<Window x:Class="HOLLauncher.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HOLLauncher"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="600" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontSize="14" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="36" Background="{DynamicResource ChromeBackBrush}">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconEmblem}" Fill="{DynamicResource GoldBrush}" Width="16" Height="16" Stretch="None" />
                    <TextBlock x:Name="TitleText" Margin="9,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource ChromeTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource ChromeCloseButton}" Height="36" HorizontalAlignment="Right" ToolTip="{local:Tr WindowClose}"
                        Click="OnCloseClick">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconStroke}" StrokeThickness="1" />
                </Button>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,4,20,18">
                <Button x:Name="YesButton" Style="{StaticResource AccentButton}" Content="{local:Tr DialogYes}" Click="OnYesClick" />
                <Button x:Name="NoButton" Style="{StaticResource SecondaryButton}" Content="{local:Tr DialogNo}" Margin="10,0,0,0"
                        Click="OnNoClick" />
                <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="{local:Tr DialogOk}" Click="OnYesClick" />
            </StackPanel>
            <Grid Margin="20,20,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,16,0">
                    <Ellipse x:Name="Badge" />
                    <Path x:Name="Glyph" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="30" Height="30" Stretch="None" />
                </Grid>
                <TextBox x:Name="MessageText" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" MaxWidth="480" BorderThickness="0"
                         Background="Transparent" Padding="0" VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
