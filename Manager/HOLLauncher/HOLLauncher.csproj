<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Launcher 5: the home window is WPF (custom chrome, key art, translucent panel). -->
    <UseWPF>true</UseWPF>
    <!-- L23: WinForms only for its NotifyIcon (WPF has no notification-area icon); its global usings are removed below so
         that WPF's Application, Window, ContextMenu, Color... stay unambiguous. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- L15: Strings.resx is French; Strings.en.resx and Strings.ja.resx become satellite assemblies (Texts.cs). -->
    <NeutralLanguage>fr</NeutralLanguage>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- One self-contained exe for players: dotnet publish -c Release -r win-x64 (no trimming: WPF does not
       support it). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HOLUpdate\HOLUpdate.csproj" />
  </ItemGroup>

  <!-- WPF's implicit usings leave System.IO and System.Net.Http out (the WinForms ones had them). -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HOLLauncher.Tests" />
  </ItemGroup>

</Project>
