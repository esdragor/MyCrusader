<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HOLUpdate\HOLUpdate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- hdiffz (patches) and hpatchz (their check) next to HOLPublish.exe: the default of the hdiffz option. -->
    <None Include="..\..\Tools\ThirdParty\HDiffPatch\*.exe" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
